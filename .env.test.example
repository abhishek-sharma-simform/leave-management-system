PORT=5000

# A separate database from your dev DATABASE_URL — tests truncate all tables
# between runs, so this must never point at your dev or prod database.
DATABASE_URL=postgresql://user:password@localhost:5432/leave_management_test

JWT_SECRET=test-secret

NODE_ENV=test

# silent avoids noisy pino output during test runs; use debug to troubleshoot.
LOG_LEVEL=silent
