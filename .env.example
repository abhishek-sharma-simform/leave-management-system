PORT=5000

# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/leave_management
DATABASE_URL=

# Secret used to sign/verify login JWTs. Use a long random string in any real deployment.
JWT_SECRET=

# development | production | test. Controls log formatting/level defaults.
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Defaults to debug in development, info in production.
LOG_LEVEL=debug
